# Cargo build output at the workspace root and in validation fixtures.
target/

# web/rn runner deps (playwright + browsers ~90MB; appium client + home).
# The lockfiles ARE committed: a determinism tool must pin Playwright et al so
# CI/release install the exact versions (npm ci), not whatever floats today.
runners/web/node_modules/
runners/web/.reproit-package-lock.sha256
runners/rn/node_modules/
.appium-home/
.hegel/

# Python caches (desktop runner parity tests)
__pycache__/
*.pyc

