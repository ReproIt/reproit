  "reasons": {
    "no_http_document": "no document navigation carries an HTTP status on this tier, so a dead route cannot be observed",
    "tauri_no_status": "tauri-driver cannot report the document's HTTP status, so a dead route cannot be proven",
    "tauri_no_request_stream": "WebDriver exposes no request stream and in-page wrappers cannot see a plain form POST, so a doubled mutation cannot be attributed to one activation",
    "no_request_stream": "the runner observes no first-party request stream on this tier, so a doubled mutation cannot be attributed to one activation",
    "tauri_no_init_script": "the WebDriver bridge has no pre-load init-script injection, so the addEventListener tally this oracle counts cannot be installed",
    "no_listener_tally": "there is no instrumentable listener or node registry on this tier, so the monotonic growth signal does not exist",
    "no_frame_timeline": "accessibility trees and terminal grids expose no frame timeline, so a stall cannot be attributed to dropped frames",
    "no_lifecycle": "a desktop window has no paused-to-resumed app lifecycle to drive, and a hidden app's accessibility tree is unreliable",
    "no_orientation": "a desktop window has no device orientation to rotate",
    "no_pty_lifecycle": "a PTY session has no device orientation and no background-to-foreground app lifecycle",
    "no_markup": "there is no client markup on this tier, so the deterministic markup hazards this oracle reads do not exist",
    "no_insets": "there are no authoritative device safe-area insets here (desktop has no insets, headless web reports every inset as 0)",
    "no_soft_keyboard": "there is no soft keyboard whose visibility the runner can read",
    "no_permission_denial": "this tier cannot deny a runtime permission, so the denial sweep that feeds this oracle never runs",
    "no_wakelock": "there is no wakelock to read (iOS exposes no public introspection; web, desktop and TUI have no wakelock concept)",
    "no_second_authority": "the accessibility tree is the only state authority on this tier, so there is no independent rendered state for it to contradict",
    "no_zoom": "there is no page zoom or resizable viewport the runner can halve, so the reflow contract has nothing to measure",
    "no_computed_color": "this tier exposes no per-element resolved foreground and background color, so an equal-color glyph run cannot be detected",
    "flat_grid": "the terminal grid is flat: an overdrawn cell is simply not rendered, so no control can be covered by a foreign element",
    "no_choice_equivalence": "the platform exposes roles and groups but no application-authored contract that sibling choices must have equivalent layout outcomes; inferring equivalence would flag legitimate asymmetric choices",
    "no_input_event_stream": "the runner can inject input and read the resulting accessibility tree but cannot observe whether the application intentionally consumed the event; a no-change result is therefore ambiguous",
    "no_focus_retention_contract": "this tier exposes touch or cursor focus but no keyboard-focus retention contract for an activated control, so a post-activation focus change is not independently a defect",
    "no_native_hit_test": "the serialized native accessibility snapshot has bounds but exposes neither the platform hit-test result nor paint stacking, so it cannot prove what covers a control",
    "no_clip_ownership": "the accessibility or terminal snapshot exposes geometry but not application ownership plus clipping and scroll-container policy, so spill cannot be distinguished from intentional scrolling or overlap",
    "no_declared_relationships": "the exposed tree strips the application-authored indicator-owner-container declaration this oracle requires, so proximity alone would be a heuristic",
    "no_native_node_identity": "Appium page-source snapshots contain values and geometry but no stable runtime object identity across frames, so a native node replacement cannot be proven",
    "no_scroll_offset_authority": "the runner can gesture or send keys but cannot identify one scroll container and restore its exact authoritative offset, so an away-and-back comparison would be ambiguous",
    "no_blank_failure_authority": "an empty accessibility tree has no independent render-failure authority on this tier; process loss belongs to the crash oracle and emptiness alone must abstain",
    "no_occlusion_ownership": "a hit-test disagreement carries no application policy distinguishing an accidental foreign cover from an intentional overlay, so emitting from geometry alone would false-positive",
    "no_presented_frame_stream": "the adapter exposes settled accessibility state but no compositor-presented frame stream, so a transient visual flash cannot be observed",
    "no_presented_rebuild_authority": "node identity may legally change without any presented visual defect, so identity churn alone cannot prove a rerender bug"
  },
