        ],
        "command": "REPROIT_ENGINE=webkit reproit BUCKET",
        "stage": "direct-replay"
      },
      {
        "assertions": [
          "project deletion response is HTTP 200"
        ],
        "command": "DELETE /v1/projects/APP",
        "stage": "retention-and-deletion"
      }
