# syntax=docker/dockerfile:1@sha256:87999aa3d42bdc6bea60565083ee17e86d1f3339802f543c0d03998580f9cb89

ARG GO_IMAGE=golang@sha256:56961d79ea8129efddcc0b8643fd8a5416b4e6228cfd477e3fd61deb2672c587
FROM ${GO_IMAGE} AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod go mod download
COPY . .
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    go build -trimpath -ldflags="-s -w" -o /out/memos ./cmd/memos

FROM alpine:3.24@sha256:28bd5fe8b56d1bd048e5babf5b10710ebe0bae67db86916198a6eec434943f8b
RUN apk add --no-cache tzdata
WORKDIR /usr/local/memos
COPY --from=build /out/memos ./memos
COPY scripts/entrypoint.sh ./entrypoint.sh
RUN mkdir -p /var/opt/memos
ENV MEMOS_MODE=prod
ENV MEMOS_PORT=5230
EXPOSE 5230
ENTRYPOINT ["./entrypoint.sh", "./memos"]
